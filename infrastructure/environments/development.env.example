# Local Docker Compose defaults. Safe only for development.
CINEARA_ENVIRONMENT=development
CINEARA_DEBUG=true
CINEARA_LOG_LEVEL=DEBUG
CINEARA_API_HOST=0.0.0.0
CINEARA_API_PORT=8000

CINEARA_POSTGRES_HOST=postgres
CINEARA_POSTGRES_PORT=5432
CINEARA_POSTGRES_DATABASE=cineara
CINEARA_POSTGRES_USER=cineara
CINEARA_POSTGRES_PASSWORD=cineara_dev_password

CINEARA_REDIS_HOST=redis
CINEARA_REDIS_PORT=6379
CINEARA_DEPENDENCY_TIMEOUT_SECONDS=1.0
