# Example only. Supply secrets through the deployment platform, not Git.
CINEARA_ENVIRONMENT=staging
CINEARA_DEBUG=false
CINEARA_LOG_LEVEL=INFO
CINEARA_API_HOST=0.0.0.0
CINEARA_API_PORT=8000

CINEARA_POSTGRES_HOST=staging-postgres.internal
CINEARA_POSTGRES_PORT=5432
CINEARA_POSTGRES_DATABASE=cineara_staging
CINEARA_POSTGRES_USER=cineara_staging
CINEARA_POSTGRES_PASSWORD=replace-with-secret-manager-reference

CINEARA_REDIS_HOST=staging-redis.internal
CINEARA_REDIS_PORT=6379
CINEARA_DEPENDENCY_TIMEOUT_SECONDS=2.0
